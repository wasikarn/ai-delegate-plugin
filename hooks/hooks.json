{
  "description": "Auto-setup hooks for ai-delegate plugin — ensures Python package is installed",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import ai_delegate\" 2>/dev/null || pip install -e \"${CLAUDE_PLUGIN_ROOT}\" --break-system-packages --quiet",
            "timeout": 30,
            "statusMessage": "Checking ai-delegate installation..."
          }
        ]
      }
    ]
  }
}