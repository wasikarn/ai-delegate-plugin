{
  "description": "Hooks for ai-delegate plugin — auto-setup, routing, context injection, and quality gates",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import ai_delegate\" 2>/dev/null || pip install -e \"${CLAUDE_PLUGIN_ROOT}\" --break-system-packages --quiet",
            "timeout": 30,
            "statusMessage": "Checking ai-delegate installation..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/detect-analysis-task.sh",
            "timeout": 10,
            "statusMessage": "Analyzing prompt..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/validate-ai-command.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/auto-audit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "security-expert|performance-expert|architecture-expert|refactor-expert|migrate-expert|testing-expert|code-quality-expert|database-expert",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/expert-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "security-expert|performance-expert|architecture-expert|refactor-expert|migrate-expert|testing-expert|code-quality-expert|database-expert",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/expert-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/analysis-summary.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/restore-debate-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}